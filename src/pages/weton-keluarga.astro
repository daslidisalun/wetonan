        <a href={u('/perkakas/')}>
          <span class="nama">Semua Perkakas</span>
          <span class="titik"></span>
          <span class="ket">daftar lengkap perkakas Wetonan</span>
        </a>
      </li>
    </ul>
  </section>

  <script>
    import { wetonOf, gregorianToJDN, jdnToGregorian, formatTanggalID } from '../lib/jawa.js';
    import { u } from '../lib/base.js';

    const MAKS = 8;
    const daftar = document.getElementById('daftar-anggota');
    const tambah = document.getElementById('tambah-anggota');
    const catatan = document.getElementById('keluarga-catatan');
    const form = document.getElementById('form-keluarga');
    const hasil = document.getElementById('hasil-keluarga');
    const tbody = document.getElementById('keluarga-tbody');

    function barisList() {
      return daftar.querySelectorAll('.baris-anggota');
    }

    function perbarui() {
      const jumlah = barisList().length;
      tambah.disabled = jumlah >= MAKS;
      barisList().forEach((baris) => {
        const hapus = baris.querySelector('.hapus-anggota');
        if (hapus) hapus.disabled = jumlah <= 1;
      });
      if (jumlah >= MAKS) {
        catatan.textContent = 'Maksimal 8 anggota.';
      } else if (catatan.textContent === 'Maksimal 8 anggota.') {
        catatan.textContent = '';
      }
    }

    function buatBaris() {
      const baris = document.createElement('div');
      baris.className = 'baris-anggota';

      const medanNama = document.createElement('div');
      medanNama.className = 'medan-anggota';
      const labelNama = document.createElement('label');
      labelNama.textContent = 'Nama';
      const inputNama = document.createElement('input');
      inputNama.type = 'text';
      inputNama.className = 'nama-anggota';
      inputNama.placeholder = 'Nama (mis. Ibu)';
      inputNama.autocomplete = 'off';
      medanNama.append(labelNama, inputNama);

      const medanTgl = document.createElement('div');
      medanTgl.className = 'medan-anggota';
      const labelTgl = document.createElement('label');
      labelTgl.textContent = 'Tanggal lahir';
      const inputTgl = document.createElement('input');
      inputTgl.type = 'date';
      inputTgl.className = 'tgl-anggota';
      inputTgl.min = '1800-01-01';
      inputTgl.max = '2100-12-31';
      medanTgl.append(labelTgl, inputTgl);

      const hapus = document.createElement('button');
      hapus.type = 'button';
      hapus.className = 'hapus-anggota tombol sekunder';
      hapus.textContent = 'Hapus';
      hapus.addEventListener('click', () => {
        if (barisList().length <= 1) return;
        baris.remove();
        perbarui();
      });

      baris.append(medanNama, medanTgl, hapus);
      return baris;
    }

    tambah.addEventListener('click', () => {
      if (barisList().length >= MAKS) {
        perbarui();
        return;
      }
      daftar.appendChild(buatBaris());
      perbarui();
    });

    // Render awal: 3 baris.
    for (let i = 0; i < 3; i++) daftar.appendChild(buatBaris());
    perbarui();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const anggota = [];
      barisList().forEach((baris) => {
        const iso = baris.querySelector('.tgl-anggota').value;
        if (!iso) return;
        const nama = baris.querySelector('.nama-anggota').value.trim();
        const [y, m, d] = iso.split('-').map(Number);
        if (!y || !m || !d) return;
        anggota.push({ nama, y, m, d });
      });

      if (anggota.length === 0) {
        catatan.textContent = 'Isi sekurang-kurangnya satu tanggal lahir.';
        hasil.hidden = true;
        return;
      }
      if (barisList().length >= MAKS) {
        catatan.textContent = 'Maksimal 8 anggota.';
      } else {
        catatan.textContent = '';
      }

      const sekarang = new Date();
      const jdnHariIni = gregorianToJDN(
        sekarang.getFullYear(),
        sekarang.getMonth() + 1,
        sekarang.getDate(),
      );

      tbody.innerHTML = '';
      anggota.forEach((a, i) => {
        const w = wetonOf(a.y, a.m, a.d);
        const sisa = ((jdnHariIni - w.jdn) % 35 + 35) % 35;
        const diff = sisa === 0 ? 0 : 35 - sisa;
        const g = jdnToGregorian(jdnHariIni + diff);
        const teksBerikutnya =
          formatTanggalID(g.y, g.m, g.d) +
          (diff === 0 ? ' (hari ini)' : ` (dalam ${diff} hari)`);

        const tr = document.createElement('tr');
        tr.className = 'baris-keluarga';

        const tdNama = document.createElement('td');
        tdNama.className = 'nama-anggota-tabel';
        tdNama.textContent = a.nama || `Anggota ${i + 1}`;

        const tdWeton = document.createElement('td');
        const tautan = document.createElement('a');
        tautan.href = u(`/weton/${w.slug}/`);
        tautan.textContent = w.nama;
        tdWeton.appendChild(tautan);

        const tdNeptu = document.createElement('td');
        tdNeptu.className = 'mono';
        tdNeptu.textContent = String(w.neptu);

        const tdJawa = document.createElement('td');
        tdJawa.textContent = `${w.jawa.tanggal} ${w.jawa.bulan.nama} ${w.jawa.tahun} AJ`;

        const tdWuku = document.createElement('td');
        tdWuku.textContent = w.wuku.nama;

        const tdBerikutnya = document.createElement('td');
        tdBerikutnya.textContent = teksBerikutnya;

        tr.append(tdNama, tdWeton, tdNeptu, tdJawa, tdWuku, tdBerikutnya);
        tbody.appendChild(tr);
      });

      hasil.hidden = false;
      hasil.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</Almanak>
