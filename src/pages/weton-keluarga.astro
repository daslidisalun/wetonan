        <p id="keluarga-catatan" class="kecil" role="status" aria-live="polite" style="margin-top:12px"></p>
      </form>
      <div id="hasil-keluarga" class="entri" hidden>
        <h3 class="tengah" style="font-size:1.5rem">Tabel Weton Keluarga</h3>
        <p class="entri-sub">Satu baris untuk setiap anggota keluarga</p>
