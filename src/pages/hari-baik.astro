---
import Almanak from '../layouts/Almanak.astro';
import { u } from '../lib/base.js';
import {
  wetonOf, golonganHariBaik, NAMA_BULAN_MASEHI, formatTanggalID,
} from '../lib/jawa.js';

// ---------- Lima golongan: sisa bagi lima -> nama & bacaan tradisi ----------
// Teks makna di bawah ini dipakai DUA kali dengan bunyi yang sama persis:
// pada tabel editorial (lewat GOLONGAN) dan pada hasil perkakas (lewat
// objek MAKNA di dalam <script> halaman ini).
const GOLONGAN = [
  {
    sisa: 1,
    nama: 'Sri',
    makna:
      'Menurut pakem primbon, Sri — dari kata sri yang berarti kemakmuran dan juga nama Dewi Sri, dewi padi — dibaca sebagai golongan paling baik dalam petungan ini. Hari bersisa Sri menurut tradisi dipilih untuk memulai hal-hal besar yang diharapkan tumbuh dan mendatangkan keberkahan: menggelar hajatan, memulai usaha, menanam, atau berangkat merantau. Penekanannya adalah niat baik dan pilihan waktu yang disengaja; bacaan ini adalah warisan tafsir budaya, bukan jaminan bahwa usaha yang dimulai pada hari itu pasti berhasil.',
  },
  {
    sisa: 2,
    nama: 'Lungguh',
    makna:
      'Menurut pakem primbon, Lungguh — dari kata lungguh yang berarti duduk dan berkedudukan — dibaca baik. Golongan ini menurut tradisi cocok untuk hal-hal yang diharapkan langgeng, menetap, dan tidak mudah goyah: pindah rumah, memulai pekerjaan tetap, melamar pekerjaan atau melamar pasangan, serta menempati kedudukan baru. Gambaran duduk yang mantap menjadi lambangnya: yang dimulai pada hari Lungguh diharapkan betah dan berakar kuat. Sebagaimana golongan lainnya, bacaan ini adalah warisan tafsir budaya, bukan kepastian tentang jalannya suatu urusan.',
  },
  {
    sisa: 3,
    nama: 'Dunia',
    makna:
      'Menurut pakem primbon, Dunia dibaca baik dan dikaitkan dengan kelapangan urusan duniawi — rezeki, pekerjaan, dan pergaulan yang luas. Hari bergolongan Dunia menurut tradisi lazim dipilih untuk perjalanan dagang, membuka usaha, mengurus pekerjaan, dan memulai perantauan, karena namanya sendiri membayangkan urusan yang terbuka ke dunia luar. Tradisi membacanya sebagai hari yang mendukung ikhtiar lahir, sementara hasilnya tetap bergantung pada kerja yang sungguh-sungguh, kejujuran, dan keadaan nyata yang dihadapi.',
  },
  {
    sisa: 4,
    nama: 'Lara',
    makna:
      'Menurut pakem primbon, Lara — dari kata lara yang berarti sakit — dibaca kurang baik dalam petungan ini. Tradisi menganjurkan menunda hal besar yang masih bisa ditunda bila harinya jatuh pada Lara, misalnya menunda keberangkatan jauh atau penandatanganan penting, sambil tetap menjalani keperluan harian seperti biasa. Penting ditegaskan bahwa Lara bukan berarti hari itu pasti celaka atau membawa sakit; ia sebatas anjuran kehati-hatian dalam budaya primbon, dan banyak urusan penting tetap berlangsung baik pada hari bergolongan Lara.',
  },
  {
    sisa: 0,
    nama: 'Pati',
    makna:
      'Menurut pakem primbon, Pati — dari kata pati yang berarti mati — adalah golongan yang paling dihindari untuk memulai hal baru yang besar, seperti membuka usaha, menggelar hajatan besar, atau berangkat merantau untuk pertama kali. Meski namanya terdengar paling keras, banyak keluarga memaknainya secara terbatas: sebatas anjuran untuk tidak memulai, bukan vonis bahwa hari itu buruk apalagi berbahaya. Hari bergolongan Pati tetaplah hari biasa untuk bekerja, belajar, beribadah, dan beristirahat; yang ditunda menurut tradisi hanyalah permulaan besar yang memang masih dapat dipilihkan hari lain.',
  },
];

// ---------- Contoh terhitung (diverifikasi terhadap pustaka jawa.js) ----------
const contohSri = wetonOf(1945, 8, 17); // Jumat Legi, neptu 11 -> sisa 1 -> Sri
const golSri = golonganHariBaik(contohSri.neptu);
const contohPati = wetonOf(2026, 1, 1); // Kamis Pon, neptu 15 -> sisa 0 -> Pati
const golPati = golonganHariBaik(contohPati.neptu);

// ---------- Pemindai bulan: render awal sisi server untuk bulan berjalan ----------
// Perkakas di browser akan merender ulang bulan yang sama saat halaman dimuat,
// lalu merender bulan lain sesuai pilihan pengunjung.
const kini = new Date();
const thnIni = kini.getFullYear();
const blnIni = kini.getMonth() + 1;
const nilaiBulanIni = `${thnIni}-${String(blnIni).padStart(2, '0')}`;
const jumlahHariIni = new Date(thnIni, blnIni, 0).getDate();
const barisIni = Array.from({ length: jumlahHariIni }, (_, i) => {
  const w = wetonOf(thnIni, blnIni, i + 1);
  return { d: i + 1, w, g: golonganHariBaik(w.neptu) };
});
const hitungIni = { Sri: 0, Lungguh: 0, Dunia: 0, Lara: 0, Pati: 0 };
for (const r of barisIni) hitungIni[r.g.nama]++;
const ringkasanIni =
  `${NAMA_BULAN_MASEHI[blnIni - 1]} ${thnIni} — Sri: ${hitungIni.Sri} hari · ` +
  `Lungguh: ${hitungIni.Lungguh} hari · Dunia: ${hitungIni.Dunia} hari · ` +
  `Lara: ${hitungIni.Lara} hari · Pati: ${hitungIni.Pati} hari`;

const faq = [
  ['Apakah golongan Pati berarti hari sial?', 'Tidak. Dalam pakem primbon, Pati adalah anjuran untuk tidak memulai hal baru yang besar pada hari itu — bukan pernyataan bahwa hari itu sial, berbahaya, atau membawa celaka. Hari bergolongan Pati tetap berjalan sebagai hari biasa: orang bekerja, belajar, bepergian, dan menggelar urusan yang tidak bisa ditunda, dan sejarah mencatat banyak peristiwa penting yang berlangsung baik pada hari Pati. Halaman ini menyajikan Pati sebagaimana tradisi memaknainya: sebatas pengingat budaya soal memilih waktu memulai, bukan vonis atas hari itu.'],
  ['Mengapa primbon lain memberi hasil berbeda untuk tanggal yang sama?', 'Karena primbon bukan satu kitab tunggal, melainkan tradisi yang disalin dan dikembangkan banyak penulis di banyak daerah. Ada versi yang hanya memakai neptu hari seperti halaman ini, ada yang menambahkan neptu weton orang yang bersangkutan, ada yang memakai pembagi atau urutan nama golongan yang berbeda, dan ada pula yang mempertimbangkan wuku atau tanggal Jawa. Perbedaan hasil antarversi adalah hal yang wajar dalam tradisi lisan dan tulisan tangan; yang dapat diperiksa bersama hanyalah aritmetikanya — neptu, pembagian, dan sisanya.'],
  ['Apakah petungan ini memakai weton saya?', 'Tidak. Versi yang dipakai halaman ini adalah petungan hari yang paling dasar: ia hanya memakai neptu hari itu sendiri — neptu dina ditambah neptu pasaran pada tanggal yang diperiksa — tanpa memasukkan weton kelahiran siapa pun. Itulah sebabnya semua orang yang memeriksa tanggal yang sama akan memperoleh golongan yang sama. Versi lain memang ada: sebagian primbon menjumlahkan neptu hari dengan neptu weton orang yang hendak memulai urusan, lalu membagi jumlahnya; hasilnya menjadi petungan pribadi dan dapat berbeda dari orang ke orang pada tanggal yang sama.'],
  ['Golongan apa yang menurut tradisi dipilih untuk hajatan dan memulai usaha?', 'Menurut pakem yang dipakai halaman ini, Sri adalah golongan yang paling sering dipilih untuk hajatan dan permulaan besar, disusul Lungguh untuk hal yang diharapkan langgeng dan menetap, serta Dunia untuk urusan dagang dan pekerjaan. Namun dalam praktik lamanya, pemilihan hari hajatan jarang berhenti pada satu petungan ini: keluarga biasanya menimbangnya bersama weton kedua calon atau penyelenggara, hari-hari yang dihindari dalam tradisi setempat, dan tentu saja kesiapan nyata penyelenggaraannya. Petungan memberi bahan pertimbangan; keputusan tetap diambil manusia yang menjalaninya.'],
  ['Bolehkah tetap menggelar acara penting pada hari Lara atau Pati?', 'Boleh, dan dalam kehidupan nyata hal itu terjadi setiap hari. Banyak acara tidak dapat dipindah — jadwal sidang, keberangkatan yang terikat tiket, urusan kedinasan, atau keadaan darurat — dan tradisi sendiri tidak pernah membatalkan urusan semacam itu hanya karena golongannya. Anjuran menunda dalam primbon ditujukan pada permulaan besar yang memang masih bebas dipilih harinya. Bila hari tidak dapat digeser, sikap tradisional yang lazim adalah melangsungkannya dengan persiapan lebih saksama dan doa, bukan membatalkannya dengan cemas.'],
];
---
<Almanak
  title="Hari Baik Tradisional — Petungan Neptu Sri, Lungguh, Dunia, Lara, Pati | Wetonan"
  description="Petungan hari baik primbon membagi neptu hari dengan lima: Sri, Lungguh, Dunia, Lara, Pati. Periksa satu tanggal atau pindai satu bulan penuh di sini."
>
  <style is:global>
    .lapangan input[type='month'] {
      font-family: var(--mono);
      font-size: 1rem;
      padding: 10px 12px;
      background: #fffdf6;
      border: 1.5px solid var(--garis-tebal);
      border-radius: 0;
      color: var(--tinta);
      min-width: 210px;
      max-width: 100%;
    }
    table.pindai {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.98rem;
      min-width: 560px;
      margin: 0 0 18px;
    }
    table.pindai th, table.pindai td {
      text-align: left;
      padding: 8px 12px;
      border-bottom: 1px solid var(--garis);
      vertical-align: top;
    }
    table.pindai thead th {
      font-family: var(--mono);
      font-weight: 500;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--tinta-lunak);
      border-bottom: 1.5px solid var(--garis-tebal);
    }
    table.pindai tbody tr:last-child td { border-bottom: 1.5px solid var(--garis-tebal); }
    table.pindai td.angka { font-family: var(--mono); }
    .chip {
      display: inline-block;
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 2px 10px;
      border: 1.5px solid var(--garis-tebal);
      white-space: nowrap;
    }
    .chip-sri { background: #a03a28; color: #fdf8ec; border-color: #7e2c1e; }
    .chip-lungguh { background: #b8892e; color: #fffdf6; border-color: #b8892e; }
    .chip-dunia { background: #6d5c33; color: #fffdf6; border-color: #6d5c33; }
    .chip-lara { background: transparent; color: #5a4c3e; border-color: #c9b995; }
    .chip-pati { background: #2a211a; color: #f4ecda; border-color: #2a211a; }
    table.fakta.fakta-golongan thead th { width: auto; }
    table.fakta-golongan td.sisa { font-family: var(--mono); text-align: center; }
  </style>

  <section class="bungkus-sempit judul-halaman">
    <p class="kicker">Bab IV — Petungan Hari</p>
    <h1>Hari Baik Menurut Petungan Neptu</h1>
    <p>
      Di antara seluruh petungan primbon, inilah yang paling ringkas: ambil neptu suatu hari —
      neptu dina ditambah neptu pasarannya — lalu bagi dengan lima. Sisanya menunjuk satu dari
      lima golongan: <strong>Sri, Lungguh, Dunia, Lara,</strong> atau <strong>Pati</strong>. Tiga
      yang pertama dibaca baik menurut pakem ini, dua yang terakhir dibaca sebagai anjuran untuk
      berhati-hati memulai hal besar. Halaman ini menyajikan petungan tersebut apa adanya sebagai
      warisan budaya: aritmetikanya dapat diperiksa siapa pun, sedangkan makna golongannya selalu
      kami sebut sebagaimana adanya — bacaan tradisi menurut primbon, bukan jaminan tentang
      bagaimana suatu hari akan berjalan.
    </p>
  </section>

  <section class="bungkus" style="margin-top:1.4rem">
    <div class="panel-almanak">
      <h2 style="font-size:1.5rem">Periksa Satu Tanggal</h2>
      <p class="subjudul">Tuliskan tanggalnya — almanak akan menunjukkan weton, neptu, sisa pembagiannya, dan golongan harinya menurut pakem primbon.</p>
      <form class="form-baris" id="form-haribaik">
        <div class="lapangan">
          <label for="tgl-haribaik">Tanggal yang diperiksa</label>
          <input type="date" id="tgl-haribaik" min="1800-01-01" max="2100-12-31" required />
        </div>
        <button class="tombol" type="submit">Periksa Golongannya</button>
      </form>
      <div class="entri" id="hasil-haribaik" hidden>
        <h3 class="entri-judul" id="haribaik-golongan"></h3>
        <p class="entri-sub" id="haribaik-sub"></p>
        <p id="haribaik-makna"></p>
        <p class="kecil"><em>Bacaan tradisi primbon sebagaimana diwariskan turun-temurun — bahan perenungan budaya, bukan jaminan tentang hasil suatu urusan dan bukan kepastian tentang hari siapa pun.</em></p>
      </div>
    </div>
  </section>

  <section class="bungkus" style="margin-top:2.2rem">
    <div class="panel-almanak">
      <h2 style="font-size:1.5rem">Pindai Satu Bulan</h2>
      <p class="subjudul">Lihat golongan seluruh hari dalam sebulan sekaligus — berguna untuk menimbang beberapa pilihan tanggal secara berdampingan.</p>
      <form class="form-baris" id="form-pindai">
        <div class="lapangan">
          <label for="pindai-bulan">Bulan yang dipindai</label>
          <input type="month" id="pindai-bulan" value={nilaiBulanIni} min="1800-01" max="2100-12" required />
        </div>
        <button class="tombol" type="submit">Pindai Bulan</button>
      </form>
      <div id="hasil-pindai">
        <p id="pindai-ringkasan" class="tengah" style="font-family:var(--mono);font-size:0.85rem;letter-spacing:0.04em;margin-top:22px">{ringkasanIni}</p>
        <div class="bungkus-tabel">
          <table class="pindai">
            <thead>
              <tr>
                <th scope="col">Tanggal</th>
                <th scope="col">Weton</th>
                <th scope="col">Neptu</th>
                <th scope="col">Sisa</th>
                <th scope="col">Golongan</th>
              </tr>
            </thead>
            <tbody id="pindai-tbody">
              {barisIni.map((r) => (
                <tr class="baris-pindai">
                  <td>{formatTanggalID(thnIni, blnIni, r.d)}</td>
                  <td>{r.w.nama}</td>
                  <td class="angka">{r.w.neptu}</td>
                  <td class="angka">{r.g.sisa}</td>
                  <td><span class={`chip chip-${r.g.nama.toLowerCase()}`}>{r.g.nama}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="kecil tengah" style="margin:4px 0 0">
          Golongan dibaca menurut pakem primbon pada halaman ini — sisa neptu dibagi lima.
          Warna lencana hanya alat bantu membaca tabel, bukan penilaian atas hari itu sendiri.
        </p>
      </div>
    </div>
  </section>

  <section class="bungkus-sempit" style="margin-top:3rem">
    <p class="kicker">Cara Petungan Bekerja</p>
    <h2>Metodenya: Neptu Hari Dibagi Lima</h2>
    <p class="huruf-awal">
      Petungan hari baik dalam bentuknya yang paling klasik tidak memerlukan data kelahiran sama
      sekali. Yang diperlukan hanyalah neptu hari yang hendak diperiksa, dan neptu itu tersusun
      dari dua angka yang sudah baku dalam primbon: <strong>neptu dina</strong> — nilai hari dalam
      saptawara, dari Selasa yang terkecil (3) sampai Sabtu yang terbesar (9) — dan
      <strong>neptu pasaran</strong> — nilai hari pasaran, dari Wage (4) sampai Pahing (9). Keduanya
      dijumlahkan menjadi neptu hari yang berkisar antara 7 (Selasa Wage) dan 18 (Sabtu Pahing).
      Tabel nilai lengkapnya dapat diperiksa di halaman
      <a href={u('/kalkulator-weton/')}>Kalkulator Weton</a>.
    </p>
    <p>
      Langkah berikutnya hanya satu: <strong>jumlah itu dibagi lima, dan yang dibaca adalah
      sisanya</strong>. Sisa 1 dibaca Sri, sisa 2 Lungguh, sisa 3 Dunia, sisa 4 Lara, dan bila
      jumlahnya habis terbagi lima — bersisa 0 — golongannya adalah Pati. Karena neptu hanya
      berkisar 7 sampai 18, seluruh kemungkinan hitungannya dapat ditulis pendek: neptu 10 dan 15
      jatuh pada Pati; 11 dan 16 pada Sri; 12 dan 17 pada Lungguh; 13 dan 18 pada Dunia; serta 7,
      8, 9, dan 14 pada Lara. Perhatikan bahwa satu golongan dapat dicapai oleh beberapa neptu
      yang berbeda — yang menentukan bukanlah besar kecilnya neptu, melainkan sisa pembagiannya.
      Inilah yang membuat petungan ini terasa berbeda dari anggapan umum bahwa neptu besar selalu
      baik dan neptu kecil selalu buruk; dalam pakem bagi lima ini, neptu terbesar (18) dan neptu
      terkecil (7) justru jatuh pada dua golongan yang berbeda arah bacaannya.
    </p>
    <p>
      Ada satu akibat aritmetis yang layak disadari sejak awal. Karena pasaran berputar lima hari
      dan dina berputar tujuh hari, golongan hari tidak berulang dalam pola mingguan yang
      sederhana, tetapi kelima golongan selalu muncul bergantian dalam setiap bulan — masing-masing
      beberapa kali. Dengan kata lain, menurut pakem ini hari bergolongan Sri bukanlah hari langka
      yang hanya muncul sesekali; dalam sebulan selalu ada beberapa hari Sri, beberapa hari
      Lungguh, dan seterusnya. Tradisi rupanya memang menyusunnya demikian: petungan ini alat untuk
      memilih di antara banyak tanggal yang tersedia, bukan alat untuk menyatakan bahwa sebagian
      besar hari tidak layak dipakai.
    </p>

    <p class="kicker" style="margin-top:2.4rem">Lima Golongan</p>
    <h2>Tabel Golongan dan Bacaan Tradisinya</h2>
    <p>
      Kelima golongan berikut adalah pakem yang paling luas beredar untuk petungan sisa bagi
      lima. Kami menuliskannya dengan bahasa kami sendiri, selalu dengan penyebutan sumbernya —
      <em>menurut pakem primbon</em> — karena makna-makna inilah bagian tradisinya, sedangkan
      hitungan di belakangnya adalah aritmetika biasa yang dapat diverifikasi siapa pun.
    </p>
    <table class="fakta fakta-golongan">
      <thead>
        <tr><th scope="col">Sisa</th><th scope="col">Golongan</th><th scope="col">Bacaan tradisi</th></tr>
      </thead>
      <tbody>
        {GOLONGAN.map((g) => (
          <tr>
            <td class="sisa">{g.sisa}</td>
            <td><strong>{g.nama}</strong></td>
            <td>{g.makna}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      Dibaca sebagai satu rangkaian, kelima nama itu membentuk tangga nada budaya yang khas.
      Sri, Lungguh, dan Dunia adalah tiga bacaan baik dengan tekanan yang berbeda — kemakmuran,
      kemantapan menetap, dan kelapangan urusan duniawi — sedangkan Lara dan Pati adalah dua
      bacaan awas dengan tekanan yang juga berbeda: Lara menganjurkan penundaan yang masih
      mungkin, Pati menganjurkan tidak memulai sama sekali untuk urusan besar. Tidak satu pun di
      antara kelimanya berbicara tentang hari yang terkutuk atau hari yang pasti membawa untung;
      seluruhnya berbicara dalam bahasa anjuran memilih waktu, yang merupakan bahasa asli primbon
      dalam hampir semua petungannya.
    </p>

    <h2 style="margin-top:2.4rem">Dua Contoh Terhitung</h2>
    <p>
      Agar setiap langkah dapat diperiksa, berikut dua tanggal yang hitungannya dibuka sampai
      selesai. Tanggal pertama adalah contoh termasyhur di seluruh situs ini: hari Proklamasi
      Kemerdekaan, 17 Agustus 1945.
    </p>
    <table class="fakta">
      <tbody>
        <tr><th>Tanggal</th><td>{formatTanggalID(1945, 8, 17)}</td></tr>
        <tr><th>Weton</th><td>{contohSri.nama}</td></tr>
        <tr><th>Neptu</th><td class="angka">{contohSri.hari.nama} {contohSri.neptuHari} + {contohSri.pasaran.nama} {contohSri.neptuPasaran} = <strong>{contohSri.neptu}</strong></td></tr>
        <tr><th>Petungan</th><td class="angka">{contohSri.neptu} ÷ 5 = {Math.floor(contohSri.neptu / 5)} sisa {golSri.sisa} → golongan <strong>{golSri.nama}</strong></td></tr>
      </tbody>
    </table>
    <p>
      Contoh kedua sengaja diambil dari ujung yang berlawanan: hari pertama tahun 2026,
      1 Januari 2026.
    </p>
    <table class="fakta">
      <tbody>
        <tr><th>Tanggal</th><td>{formatTanggalID(2026, 1, 1)}</td></tr>
        <tr><th>Weton</th><td>{contohPati.nama}</td></tr>
        <tr><th>Neptu</th><td class="angka">{contohPati.hari.nama} {contohPati.neptuHari} + {contohPati.pasaran.nama} {contohPati.neptuPasaran} = <strong>{contohPati.neptu}</strong></td></tr>
        <tr><th>Petungan</th><td class="angka">{contohPati.neptu} ÷ 5 = {Math.floor(contohPati.neptu / 5)} sisa {golPati.sisa} → golongan <strong>{golPati.nama}</strong></td></tr>
      </tbody>
    </table>
    <p>
      Kedua contoh ini sekaligus menunjukkan batas jujur petungan tersebut. Hari Proklamasi —
      hari yang dalam ingatan bangsa adalah permulaan besar yang berhasil — jatuh pada golongan
      Sri, sedangkan Tahun Baru 2026, yang dirayakan jutaan orang sebagai awal yang penuh harapan,
      jatuh pada golongan Pati. Keadaan semacam itu bukan kebetulan yang mengejutkan: hari-hari
      besar dalam sejarah tersebar ke semua golongan, karena golongan ditentukan oleh putaran
      angka yang berjalan terus tanpa memandang peristiwa. Petungan ini adalah aritmetika warisan
      budaya — sebuah cara lama memberi nama pada waktu dan membicarakan pilihan tanggal — bukan
      vonis tentang hari-hari itu sendiri, dan bukan pula penjelasan mengapa suatu peristiwa
      berhasil atau gagal. Wetonan menyajikannya dalam kedudukan itu: menarik untuk dipelajari,
      sah untuk dipakai sebagai bahan pertimbangan budaya, dan tidak untuk ditakuti.
    </p>

    <h2 style="margin-top:2.4rem">Varian-Varian Petungan Hari Baik</h2>
    <p>
      Halaman ini memakai versi yang paling sederhana dan paling luas diajarkan: hanya neptu hari
      yang dibagi lima. Di luar versi ini, primbon mengenal beberapa varian yang perlu diketahui
      agar pembaca tidak bingung bila menemukan hasil berbeda di sumber lain. Varian pertama
      adalah <strong>petungan pribadi</strong>: neptu hari dijumlahkan dengan neptu weton orang
      yang hendak memulai urusan, lalu jumlah bersama itu yang dibagi lima — hasilnya berbeda dari
      orang ke orang pada tanggal yang sama, karena weton kelahiran ikut menentukan. Varian kedua
      mengubah <strong>pembaginya</strong>: ada petungan hari yang membagi neptu dengan angka lain
      dan menghasilkan rangkaian nama golongan yang berbeda pula. Varian ketiga berbeda pada
      <strong>urutan dan penamaan</strong>: susunan nama golongan sesudah Sri tidak selalu sama di
      setiap kitab dan setiap daerah, karena tradisi ini lama hidup dalam salinan tulisan tangan.
      Ada pula keluarga yang menimbang hasil bagi lima ini bersama pertimbangan lain — wuku
      pekan itu, tanggal Jawa, atau hari-hari khusus yang dihindari setempat. Semua varian itu sah
      sebagai tradisi daerahnya masing-masing; yang kami pakai di sini kami sebutkan dengan terang
      supaya hitungannya dapat diperiksa dan dibandingkan, bukan supaya varian lain dinyatakan
      salah.
    </p>

    <h2 style="margin-top:2.4rem">Cara Memakai Pemindai Bulan</h2>
    <p>
      Perkakas kedua di halaman ini, <strong>Pindai Satu Bulan</strong>, dibuat untuk cara orang
      sesungguhnya memilih tanggal: jarang ada yang hanya memeriksa satu hari; yang lazim adalah
      menimbang beberapa pilihan dalam satu bulan — misalnya tiga akhir pekan untuk hajatan, atau
      pekan-pekan kosong untuk membuka usaha. Caranya sederhana. Pilih bulan dan tahun pada
      isian bulan, lalu tekan <em>Pindai Bulan</em>. Tabel akan menampilkan seluruh hari dalam
      bulan itu — tiga puluh baris untuk bulan November 2026, tiga puluh satu untuk bulan yang
      berumur 31 hari — masing-masing lengkap dengan weton, neptu, sisa pembagiannya, dan lencana
      berwarna golongannya. Baris ringkasan di atas tabel menghitung berapa hari jatuh pada
      masing-masing golongan, sehingga pembaca langsung melihat sebarannya tanpa menghitung
      sendiri.
    </p>
    <p>
      Tiga hal membantu membaca hasil pindaian dengan benar. Pertama, perhatikan bahwa yang
      berubah dari hari ke hari adalah sisanya, dan sisa itu bergerak tidak beraturan bila dibaca
      sekilas, karena ia hasil gabungan dua putaran — tujuh hari dan lima pasaran — yang berjalan
      bersamaan. Kedua, bila bulan yang dipindai menampakkan banyak hari Lara atau Pati pada
      pekan yang direncanakan, ingatlah bacaan tradisinya secara tepat: yang dianjurkan ditunda
      hanyalah permulaan besar yang masih bebas dipilih; urusan yang terikat jadwal tetap
      berlangsung sebagaimana mestinya. Ketiga, pakailah hasil pindaian sebagai bahan musyawarah,
      bukan keputusan otomatis — dalam pemakaian lamanya pun, daftar hari baik selalu dibicarakan
      bersama keluarga dan ditimbang dengan kesiapan nyata, ketersediaan tempat, dan pertimbangan
      lain yang jauh lebih menentukan jalannya acara daripada sekadar angka sisa.
    </p>
  </section>

