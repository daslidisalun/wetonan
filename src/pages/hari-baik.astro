  <section class="bungkus-sempit" style="margin-top:2.6rem">
    <p class="kicker">Perkakas Terkait</p>
    <h2>Perkakas Terkait</h2>
    <p>
      Petungan hari baik berdiri di atas hitungan weton, dan situs ini menyediakan perkakas
      pendampingnya: <a href={u('/kalkulator-weton/')}>Kalkulator Weton</a> untuk menemukan
      weton dan neptu dari tanggal berapa pun, halaman <a href={u('/siklus-weton/')}>Siklus
      Weton</a> untuk menelusuri putaran 35 hari secara utuh,
      <a href={u('/weton-jodoh/')}>Weton Jodoh</a> untuk petungan kecocokan pasangan menurut
      tradisi, serta <a href={u('/perkakas/')}>indeks semua perkakas</a> untuk melihat seluruh
      alat hitung yang tersedia di Wetonan.
    </p>
  </section>

  <script>
    import { wetonOf, golonganHariBaik, NAMA_BULAN_MASEHI, formatTanggalID } from '../lib/jawa.js';
    import { esc } from '../lib/entri.js';

    // Bacaan tradisi kelima golongan — bunyinya sama persis dengan tabel
    // editorial di halaman ini (objek GOLONGAN pada bagian atas berkas).
    const MAKNA = {
      Sri:
        'Menurut pakem primbon, Sri — dari kata sri yang berarti kemakmuran dan juga nama Dewi Sri, dewi padi — dibaca sebagai golongan paling baik dalam petungan ini. Hari bersisa Sri menurut tradisi dipilih untuk memulai hal-hal besar yang diharapkan tumbuh dan mendatangkan keberkahan: menggelar hajatan, memulai usaha, menanam, atau berangkat merantau. Penekanannya adalah niat baik dan pilihan waktu yang disengaja; bacaan ini adalah warisan tafsir budaya, bukan jaminan bahwa usaha yang dimulai pada hari itu pasti berhasil.',
      Lungguh:
        'Menurut pakem primbon, Lungguh — dari kata lungguh yang berarti duduk dan berkedudukan — dibaca baik. Golongan ini menurut tradisi cocok untuk hal-hal yang diharapkan langgeng, menetap, dan tidak mudah goyah: pindah rumah, memulai pekerjaan tetap, melamar pekerjaan atau melamar pasangan, serta menempati kedudukan baru. Gambaran duduk yang mantap menjadi lambangnya: yang dimulai pada hari Lungguh diharapkan betah dan berakar kuat. Sebagaimana golongan lainnya, bacaan ini adalah warisan tafsir budaya, bukan kepastian tentang jalannya suatu urusan.',
      Dunia:
        'Menurut pakem primbon, Dunia dibaca baik dan dikaitkan dengan kelapangan urusan duniawi — rezeki, pekerjaan, dan pergaulan yang luas. Hari bergolongan Dunia menurut tradisi lazim dipilih untuk perjalanan dagang, membuka usaha, mengurus pekerjaan, dan memulai perantauan, karena namanya sendiri membayangkan urusan yang terbuka ke dunia luar. Tradisi membacanya sebagai hari yang mendukung ikhtiar lahir, sementara hasilnya tetap bergantung pada kerja yang sungguh-sungguh, kejujuran, dan keadaan nyata yang dihadapi.',
      Lara:
        'Menurut pakem primbon, Lara — dari kata lara yang berarti sakit — dibaca kurang baik dalam petungan ini. Tradisi menganjurkan menunda hal besar yang masih bisa ditunda bila harinya jatuh pada Lara, misalnya menunda keberangkatan jauh atau penandatanganan penting, sambil tetap menjalani keperluan harian seperti biasa. Penting ditegaskan bahwa Lara bukan berarti hari itu pasti celaka atau membawa sakit; ia sebatas anjuran kehati-hatian dalam budaya primbon, dan banyak urusan penting tetap berlangsung baik pada hari bergolongan Lara.',
      Pati:
        'Menurut pakem primbon, Pati — dari kata pati yang berarti mati — adalah golongan yang paling dihindari untuk memulai hal baru yang besar, seperti membuka usaha, menggelar hajatan besar, atau berangkat merantau untuk pertama kali. Meski namanya terdengar paling keras, banyak keluarga memaknainya secara terbatas: sebatas anjuran untuk tidak memulai, bukan vonis bahwa hari itu buruk apalagi berbahaya. Hari bergolongan Pati tetaplah hari biasa untuk bekerja, belajar, beribadah, dan beristirahat; yang ditunda menurut tradisi hanyalah permulaan besar yang memang masih dapat dipilihkan hari lain.',
    };

    // ----- Mode A: periksa satu tanggal -----
    const formHari = document.getElementById('form-haribaik');
    const inputHari = document.getElementById('tgl-haribaik');
    const hasilHari = document.getElementById('hasil-haribaik');
    const elGolongan = document.getElementById('haribaik-golongan');
    const elSub = document.getElementById('haribaik-sub');
    const elMakna = document.getElementById('haribaik-makna');

    formHari.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!inputHari.value) return;
      const [y, m, d] = inputHari.value.split('-').map(Number);
      const w = wetonOf(y, m, d);
      const g = golonganHariBaik(w.neptu);
      elGolongan.textContent = g.nama;
      elSub.textContent = `${w.nama} · neptu ${w.neptu} · ${w.neptu} ÷ 5 sisa ${g.sisa}`;
      elMakna.textContent = MAKNA[g.nama];
      hasilHari.hidden = false;
      hasilHari.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // ----- Mode B: pindai satu bulan -----
    const formPindai = document.getElementById('form-pindai');
    const inputBulan = document.getElementById('pindai-bulan');
    const elRingkasan = document.getElementById('pindai-ringkasan');
    const elTbody = document.getElementById('pindai-tbody');

    function pindai(y, m) {
      const jumlahHari = new Date(y, m, 0).getDate();
      const hitung = { Sri: 0, Lungguh: 0, Dunia: 0, Lara: 0, Pati: 0 };
      let baris = '';
      for (let d = 1; d <= jumlahHari; d++) {
        const w = wetonOf(y, m, d);
        const g = golonganHariBaik(w.neptu);
        hitung[g.nama]++;
        baris +=
          `<tr class="baris-pindai">` +
          `<td>${esc(formatTanggalID(y, m, d))}</td>` +
          `<td>${esc(w.nama)}</td>` +
          `<td class="angka">${w.neptu}</td>` +
          `<td class="angka">${g.sisa}</td>` +
          `<td><span class="chip chip-${esc(g.nama.toLowerCase())}">${esc(g.nama)}</span></td>` +
          `</tr>`;
      }
      elTbody.innerHTML = baris;
      elRingkasan.textContent =
        `${NAMA_BULAN_MASEHI[m - 1]} ${y} — Sri: ${hitung.Sri} hari · ` +
        `Lungguh: ${hitung.Lungguh} hari · Dunia: ${hitung.Dunia} hari · ` +
        `Lara: ${hitung.Lara} hari · Pati: ${hitung.Pati} hari`;
    }

    formPindai.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!inputBulan.value) return;
      const y = Number(inputBulan.value.slice(0, 4));
      const m = Number(inputBulan.value.slice(5, 7));
      pindai(y, m);
    });

    // Saat halaman dimuat: tetapkan bulan berjalan dan render otomatis.
    const sekarang = new Date();
    const yIni = sekarang.getFullYear();
    const mIni = sekarang.getMonth() + 1;
    inputBulan.value = `${yIni}-${String(mIni).padStart(2, '0')}`;
    pindai(yIni, mIni);
  </script>
