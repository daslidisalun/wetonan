---
import Almanak from '../layouts/Almanak.astro';
import { BULAN_JAWA, PANJANG_BULAN, WINDU, PANJANG_TAHUN_WINDU } from '../lib/jawa.js';
import { kalenderHTML } from '../lib/entri.js';

const CATATAN_BULAN_KAL = [
  'Serapan Asyura; awal tahun yang diperingati dengan laku prihatin.',
  'Pengikut Suro; namanya serumpun dengan Safar.',
  'Bulan peringatan kelahiran Nabi, dari kata maulid.',
  'Secara harfiah "setelah Mulud"; pasangan bulan ketiga.',
  'Serapan Jumada pertama; bulan kelima Hijriah.',
  'Serapan Jumada terakhir; menutup enam bulan pertama.',
  'Serapan Rajab; termasuk bulan yang dihormati.',
  'Musim nyadran: mendoakan leluhur sebelum Ramadan tiba.',
  'Masa berpuasa penuh; namanya berarti puasa.',
  'Hari raya Idulfitri jatuh di awal bulan ini.',
  'Nama lainnya Sela atau Apit, karena posisinya mengapit.',
  'Musim haji dan Iduladha, ditutup Grebeg Besar.',
];

const kini = new Date();
const kalenderAwal = kalenderHTML(kini.getFullYear(), kini.getMonth() + 1);
const nilaiBulanAwal = `${kini.getFullYear()}-${String(kini.getMonth() + 1).padStart(2, '0')}`;
---
<Almanak
  title="Kalender Jawa — Penanggalan Jawa Bulan demi Bulan | Wetonan"
  description="Kalender Jawa interaktif: berpindah bulan untuk melihat padanan tanggal Masehi, pasaran, weton, dan tanggal Jawa setiap hari, lengkap dengan penjelasan dua belas bulan Jawa dan siklus windu delapan tahun."
>
  <section class="bungkus-sempit judul-halaman">
    <p class="kicker">Bab III — Penanggalan</p>
    <h1>Kalender Jawa</h1>
    <p>
      Penanggalan ini mempertemukan tiga putaran waktu sekaligus: tanggal Masehi, hari pasaran, dan
      tanggal Jawa. Geser bulan untuk menelusuri tahun-tahun lampau atau yang akan datang — setiap
      tanggal dapat diketuk untuk membuka entri wetonnya.
    </p>
  </section>

  <section class="bagian-gelap" style="margin-top:1.6rem">
    <div class="bungkus">
      <div class="panah-bulan">
        <button class="tombol sekunder" id="bln-sebelum" type="button" style="color:#efe6cf;border-color:#efe6cf">← Bulan Sebelumnya</button>
        <form id="form-lompat" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
          <div class="lapangan">
            <label for="lompat-bulan" style="color:#cbbd97">Lompat ke bulan</label>
            <input type="month" id="lompat-bulan" value={nilaiBulanAwal} min="1800-01" max="2100-12" style="font-family:var(--mono);font-size:1rem;padding:9px 12px;border:1.5px solid #efe6cf;background:#fffdf6;color:#2a211a" />
          </div>
          <button class="tombol" type="submit">Tampilkan</button>
          <button class="tombol sekunder" id="bln-ini" type="button" style="color:#efe6cf;border-color:#efe6cf">Bulan Ini</button>
        </form>
        <button class="tombol sekunder" id="bln-berikut" type="button" style="color:#efe6cf;border-color:#efe6cf">Bulan Berikutnya →</button>
      </div>
      <div class="bungkus-tabel" id="wadah-kalender" set:html={kalenderAwal}></div>
      <p class="kecil" style="color:#cbbd97;margin-top:14px">
        Keterangan: angka besar adalah tanggal Masehi; di bawahnya nama pasaran dan neptu weton hari itu
        (n = neptu); baris ketiga adalah tanggal dan bulan Jawa. Tanggal hari ini tertanda merah bata.
      </p>
    </div>
  </section>

  <section class="bungkus-sempit" style="margin-top:3rem">
    <p class="kicker">Membaca Tabel</p>
    <h2>Cara Membaca Tabel Bulan</h2>
    <p>
      Setiap sel pada tabel di atas memuat tiga lapis keterangan dalam satu tanggal. Yang paling
      besar adalah <strong>tanggal Masehi</strong>-nya. Tepat di bawahnya tertulis
      <strong>nama pasaran beserta neptu weton</strong> hari itu — dari baris inilah pembaca tahu
      weton suatu tanggal tanpa membuka halaman lain. Baris ketiga, yang terkecil, adalah
      <strong>tanggal dan bulan Jawa</strong>-nya. Tanggal hari berjalan diberi tanda merah bata
      agar mudah ditemukan sekilas, dan mengetuk tanggal mana pun akan membuka entri kalkulator
      hari itu lengkap dengan wuku dan tanggal Jawanya. Keterangan di kepala tabel menyebut bulan
      Masehi beserta bulan-bulan Jawa yang terentang di dalamnya, sebab satu bulan Masehi hampir
      selalu memuat akhir satu bulan Jawa dan awal bulan berikutnya.
    </p>

    <p class="kicker" style="margin-top:2.4rem">Di Balik Tabel</p>
    <h2>Sistemnya Sekaligus: Tiga Putaran yang Bertumpuk</h2>
    <p>
      Kalender ini tampak padat karena tiga putaran berjalan di atas hari yang sama. Putaran
      pertama adalah <strong>pasaran</strong> yang berputar setiap lima hari: Legi, Pahing, Pon,
      Wage, Kliwon, lalu kembali ke Legi. Putaran kedua adalah pekan tujuh hari. Karena lima dan
      tujuh tidak memiliki pembagi bersama, gabungan keduanya baru kembali ke pasangan yang sama
      setelah 5 × 7 = <strong>35 hari</strong> — inilah putaran weton, dan setiap kombinasi muncul
      tepat satu kali di dalamnya. Putaran ketiga adalah <strong>pawukon</strong> yang berumur
      210 hari. Angka 210 adalah enam kali 35, sehingga dalam satu putaran pawukon weton yang sama
      muncul enam kali; setiap kemunculan berikutnya melompat lima wuku dari kemunculan
      sebelumnya, dan pasangan weton–wuku yang persis sama baru bertemu lagi setelah genap 210
      hari. Menumpuknya ketiga putaran inilah yang membuat satu tanggal Jawa tidak pernah
      benar-benar berulang dalam waktu dekat.
    </p>
    <p>
      Dari ketiga putaran itu, pasaran adalah yang paling terasa dalam kehidupan sehari-hari.
      Banyak pasar tradisional di Jawa hingga kini masih menyebut hari ramainya dengan nama
      pasaran — pasar yang ramai tiap Legi, misalnya, atau tiap Pon — dan warga sekitar
      menyesuaikan kunjungan belanjanya dengan irama lima hari itu, bukan dengan tanggal
      Masehi. Nama pasaran juga melekat pada nama tempat dan nama hari dalam percakapan:
      menyebut "besok Kliwon" sering cukup dimengerti tanpa menyebut tanggalnya. Tabel bulan
      di halaman ini menjaga kebiasaan itu tetap terbaca: pasaran ditulis pada setiap tanggal,
      berdampingan dengan padanan Jawanya, persis seperti almanak cetak yang dulu digantung
      di dinding rumah.
    </p>
  </section>

  <section class="bungkus-sempit" style="margin-top:3rem">
    <p class="kicker">Dua Belas Bulan</p>
    <h2>Bulan-Bulan dalam Kalender Jawa</h2>
    <p class="huruf-awal">
      Nama bulan Jawa adalah warisan dua zaman. Suro berasal dari Asyura, Sapar dari Safar, Mulud dari
      maulid Nabi, Poso dari puasa — jejak penyelarasan Sultan Agung dengan kalender Hijriah masih
      terbaca jelas hingga kini. Umur bulan berselang-seling 30 dan 29 hari, mengikuti peredaran bulan
      yang sebenarnya; hanya bulan pamungkas, Besar, yang berubah: 29 hari pada tahun biasa dan 30 hari
      pada tahun wuntu (kabisat).
    </p>
    <table class="fakta">
      <tbody>
        {BULAN_JAWA.map((b, i) => (
          <tr>
            <th>{i + 1}. {b.nama}</th>
            <td>bertepatan bulan {b.alt} — {PANJANG_BULAN[i]} hari{i === 11 ? ' (30 pada tahun wuntu)' : ''}. {CATATAN_BULAN_KAL[i]}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 style="margin-top:2.4rem">Windu: Lingkaran Delapan Tahun</h2>
    <p>
      Delapan tahun Jawa membentuk satu <strong>windu</strong>. Tiga tahun di dalamnya berumur 355 hari
      — Ehe, Dal, dan Jimakir — karena bulan Besar-nya berumur genap 30 hari; lima tahun lainnya berumur
      354 hari. Sebutan untuk kedelapan tahun itu sarat makna dalam budaya Jawa: tahun Alip misalnya
      kerap dikaitkan dengan awal dan kemakmuran, sedangkan tahun Dal — tahun ketika banyak peristiwa
      besar dicatat dalam babad — dipandang berwibawa sekaligus berat.
    </p>
    <table class="fakta">
      <tbody>
        {WINDU.map((nama, i) => (
          <tr>
            <th>Tahun ke-{i + 1}: {nama}</th>
            <td class="angka">{PANJANG_TAHUN_WINDU[i]} hari{PANJANG_TAHUN_WINDU[i] === 355 ? ' — tahun wuntu (kabisat)' : ''}</td>
          </tr>
        ))}
        <tr><th>Jumlah satu windu</th><td class="angka"><strong>2.835 hari</strong></td></tr>
      </tbody>
    </table>
    <p>
      Satu catatan penting bagi pembaca penanggalan cetak: hari Jawa dimulai saat matahari terbenam.
      Karena itu peringatan malam 1 Suro selalu jatuh pada senja <em>sebelum</em> tanggal 1 Suro-nya —
      misalnya malam 1 Suro 1959 dimulai Kamis senja, 26 Juni 2025, sedangkan tanggal 1 Suro-nya sendiri
      adalah Jumat, 27 Juni 2025. Kalender di halaman ini mengikuti padanan tanggal sipil resmi, sama
      seperti kalender Kementerian Agama RI.
    </p>
    <p>
      Hari lebihan pada tahun kabisat selalu diletakkan di ujung tahun, pada bulan Besar, agar
      urutan bulan-bulan sebelumnya tidak bergeser. Tahun <strong>1959 adalah tahun Dal</strong>,
      salah satu dari tiga tahun wuntu dalam windu, sehingga Besar 1959 berumur 30 hari, bukan 29.
      Konsekuensinya terasa pada tahun berikutnya: dengan satu hari tambahan itu, 1 Suro 1960
      jatuh pada <strong>17 Juni 2026</strong>. Pembaca yang membandingkan kalender cetak lama
      dengan tabel di halaman ini akan menemukan selisih justru pada titik-titik peralihan
      seperti ini bila penanggal lamanya meletakkan hari lebihan di tempat lain.
    </p>

    <h2 style="margin-top:2.4rem">Mengubah Tanggal dengan Tangan</h2>
    <p>
      Sebagai penutup, mari ubah satu tanggal tanpa kalkulator: <strong>9 November 2026</strong>.
      Jangkar terdekatnya adalah 1 Januari 2026, yang sudah kita ketahui bersama — Kamis Pon,
      bertepatan dengan 12 Rejeb 1959, tahun Dal.
    </p>
    <ol>
      <li><strong>Hitung selisihnya.</strong> Dari 1 Januari sampai 9 November 2026 terdapat <span class="mono">312</span> hari.</li>
      <li><strong>Tentukan dinanya.</strong> 312 ÷ 7 menyisakan <span class="mono">4</span>. Maju empat hari dari Kamis — Jumat, Sabtu, Minggu, <strong>Senin</strong>.</li>
      <li><strong>Tentukan pasarannya.</strong> 312 ÷ 5 menyisakan <span class="mono">2</span>. Maju dua pasaran dari Pon — Wage, lalu <strong>Kliwon</strong>.</li>
      <li><strong>Jalankan tanggal Jawanya ke depan.</strong> Menghitung bulan demi bulan dari 12 Rejeb 1959 — melewati pergantian tahun ke 1960, tahun Be — sampailah pada <strong>28 Jumadilawal 1960</strong>.</li>
      <li><strong>Lengkapi dengan wuku dan neptu.</strong> Pekan pawukon pada hari itu adalah <strong>Landep</strong>, dan neptunya Senin 4 + Kliwon 8 = <strong>12</strong>.</li>
    </ol>
    <p>
      Hasil akhirnya: 9 November 2026 adalah <strong>Senin Kliwon</strong>, neptu 12, tanggal
      28 Jumadilawal 1960 tahun Be, wuku Landep. Ketuk tanggal itu pada tabel di atas dan entri
      yang terbuka akan menunjukkan angka yang sama — hitungan tangan dan almanak digital di
      situs ini memang memakai jangkar serta putaran yang sama.
    </p>
  </section>

  <script>
    import { kalenderHTML } from '../lib/entri.js';
    const wadah = document.getElementById('wadah-kalender');
    const lompat = document.getElementById('lompat-bulan');
    let tahun = Number(lompat.value.slice(0, 4));
    let bulan = Number(lompat.value.slice(5, 7));

    function tampil() {
      wadah.innerHTML = kalenderHTML(tahun, bulan);
      lompat.value = `${tahun}-${String(bulan).padStart(2, '0')}`;
    }
    document.getElementById('bln-sebelum').addEventListener('click', () => {
      bulan--; if (bulan < 1) { bulan = 12; tahun--; } tampil();
    });
    document.getElementById('bln-berikut').addEventListener('click', () => {
      bulan++; if (bulan > 12) { bulan = 1; tahun++; } tampil();
    });
    document.getElementById('bln-ini').addEventListener('click', () => {
      const n = new Date(); tahun = n.getFullYear(); bulan = n.getMonth() + 1; tampil();
    });
    document.getElementById('form-lompat').addEventListener('submit', (e) => {
      e.preventDefault();
      if (!lompat.value) return;
      tahun = Number(lompat.value.slice(0, 4));
      bulan = Number(lompat.value.slice(5, 7));
      tampil();
    });
  </script>
</Almanak>
