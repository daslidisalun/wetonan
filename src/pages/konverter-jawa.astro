  <section class="bungkus-sempit" style="margin-top:2.6rem">
    <p class="kicker">Perkakas Terkait</p>
    <h2>Perkakas Terkait</h2>
    <p>
      Konverter ini adalah satu dari beberapa perkakas penanggalan yang saling memeriksa di situs ini.
      Pakailah perkakas di bawah ini untuk arah hitungan sebaliknya, untuk melihat padanan tanggal
      dalam konteks satu bulan penuh, untuk memahami siklus yang melatarinya, atau untuk membuka
      daftar seluruh perkakas yang tersedia.
    </p>
    <ul>
      <li><a href={u('/kalkulator-weton/')}>Kalkulator Weton</a> — arah sebaliknya: dari tanggal Masehi menuju weton, neptu, dan tanggal Jawa; tempat memeriksa hasil konverter ini.</li>
      <li><a href={u('/kalender-jawa/')}>Kalender Jawa</a> — padanan tanggal Jawa–Masehi bulan demi bulan, untuk melihat hasil konversi di antara hari-hari tetangganya.</li>
      <li><a href={u('/siklus-weton/')}>Siklus Weton</a> — putaran 35 hari pertemuan saptawara dan pasaran, serta bagaimana weton yang sama berulang dan diperingati sebagai selapanan.</li>
      <li><a href={u('/perkakas/')}>Perkakas</a> — daftar seluruh perkakas almanak di Wetonan, dari petungan jodoh sampai penelusuran wuku dan hari baik.</li>
    </ul>
    <p class="kecil">
      Seluruh perkakas di Wetonan memakai jangkar dan tabel yang sama, sehingga hasil satu perkakas
      selalu dapat diperiksa pada perkakas lainnya. Isi situs ini disajikan sebagai warisan budaya —
      bukan ramalan dan bukan nasihat untuk mengambil keputusan hidup.
    </p>
  </section>

  <script>
    import { wetonFromJawa, panjangBulanJawa, tahunJawaInfo, formatTanggalID, BULAN_JAWA } from '../lib/jawa.js';
    import { u } from '../lib/base.js';

    const form = document.getElementById('form-konverter');
    const selTanggal = document.getElementById('konv-tanggal');
    const selBulan = document.getElementById('konv-bulan');
    const inpTahun = document.getElementById('konv-tahun');
    const infoTahun = document.getElementById('konv-info-tahun');
    const kotakError = document.getElementById('konverter-error');
    const hasil = document.getElementById('hasil-konverter');

    const pad2 = (n) => String(n).padStart(2, '0');

    function bacaMasukan() {
      return {
        tanggal: Number(selTanggal.value),
        bulanIdx: Number(selBulan.value),
        tahun: Number(inpTahun.value),
      };
    }

    function perbaruiInfoTahun() {
      const { tahun } = bacaMasukan();
      if (!Number.isFinite(tahun) || tahun === 0) {
        infoTahun.textContent = '';
        return;
      }
      const info = tahunJawaInfo(tahun);
      const besar = panjangBulanJawa(11, tahun);
      const sebutan = info.kabisat ? 'tahun wuntu (kabisat)' : 'tahun biasa';
      infoTahun.textContent =
        `Tahun ${tahun} adalah tahun ${info.windu} — ${sebutan}, ${info.panjang} hari; ` +
        `bulan Besar berumur ${besar} hari.`;
    }

    function sembunyikanError() {
      kotakError.hidden = true;
      kotakError.textContent = '';
    }

    function padaPerubahan() {
      perbaruiInfoTahun();
      const { tanggal, bulanIdx, tahun } = bacaMasukan();
      if (Number.isFinite(tahun) && tanggal <= panjangBulanJawa(bulanIdx, tahun)) {
        sembunyikanError();
      }
    }

    selTanggal.addEventListener('input', padaPerubahan);
    selTanggal.addEventListener('change', padaPerubahan);
    selBulan.addEventListener('input', padaPerubahan);
    selBulan.addEventListener('change', padaPerubahan);
    inpTahun.addEventListener('input', padaPerubahan);
    inpTahun.addEventListener('change', padaPerubahan);
    perbaruiInfoTahun();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const { tanggal, bulanIdx, tahun } = bacaMasukan();
      if (!Number.isFinite(tahun)) return;
      const panjang = panjangBulanJawa(bulanIdx, tahun);
      if (tanggal > panjang) {
        const namaBulan = BULAN_JAWA[bulanIdx].nama;
        kotakError.textContent =
          `Tanggal ${tanggal} tidak ada pada bulan ${namaBulan} ${tahun} AJ — ` +
          `bulan ${namaBulan} pada tahun ${tahun} hanya berumur ${panjang} hari. ` +
          `Pilih tanggal 1 sampai ${panjang}.`;
        kotakError.hidden = false;
        hasil.hidden = true;
        return;
      }
      sembunyikanError();
      const w = wetonFromJawa(tanggal, bulanIdx, tahun);
      const g = w.gregorian;
      const iso = `${g.y}-${pad2(g.m)}-${pad2(g.d)}`;
      const tglMasehi = formatTanggalID(g.y, g.m, g.d);
      const tglJawa = `${w.jawa.tanggal} ${w.jawa.bulan.nama} ${w.jawa.tahun} AJ`;
      hasil.innerHTML =
        `<h3 class="entri-judul">${w.nama}</h3>` +
        `<p class="entri-sub">${tglMasehi}</p>` +
        `<table class="fakta"><tbody>` +
        `<tr><th>Tanggal Masehi</th><td>${tglMasehi}</td></tr>` +
        `<tr><th>Tanggal Jawa</th><td>${tglJawa}</td></tr>` +
        `<tr><th>Neptu</th><td class="angka">${w.hari.nama} ${w.neptuHari} + ${w.pasaran.nama} ${w.neptuPasaran} = ${w.neptu}</td></tr>` +
        `<tr><th>Tahun &amp; windu</th><td>${w.jawa.tahun} — tahun ${w.jawa.windu}${w.jawa.kabisat ? ' (tahun wuntu/kabisat, 355 hari)' : ' (354 hari)'}</td></tr>` +
        `<tr><th>Wuku</th><td>${w.wuku.nama} — hari ke-${w.wuku.hariKe} dalam pekan wuku</td></tr>` +
        `<tr><th>Tautan</th><td><a href="${u(`/weton/${w.slug}/`)}">Detail weton ${w.nama} →</a><br /><a href="${u(`/kalkulator-weton/?tgl=${iso}`)}">Periksa di Kalkulator Weton →</a></td></tr>` +
        `</tbody></table>` +
        `<p class="kecil"><em>Ingat batas magrib: hari Jawa ini dimulai sejak matahari terbenam pada petang hari sebelumnya dalam tanggal Masehi.</em></p>`;
      hasil.hidden = false;
      hasil.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
